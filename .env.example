# RPC endpoint for the network you're deploying/testing against (use a testnet first)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer/executor private key - NEVER commit the real .env file, NEVER use a mainnet key with real funds for testing
PRIVATE_KEY=0xyourprivatekey

# Optional, for contract verification
ETHERSCAN_API_KEY=

# Aave V3 PoolAddressesProvider for the target network
AAVE_ADDRESSES_PROVIDER=0x0496275d34753A48320CA58103d5220d394FF77

# Deployed FlashLoanArbitrage contract address (fill in after deploy)
ARBITRAGE_CONTRACT=

# Path to the routers/pairs to scan. See markets.config.json for the format -
# any number of routers (all pairwise combinations are tried) and any number
# of token pairs, each with its own base borrow amount.
MARKETS_CONFIG=./markets.config.json

# Max acceptable slippage per swap leg, in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# Comma-separated loan sizes to test per pair, as basis points of that pair's
# baseAmount (10000 = 1x). Default if unset: 2500,5000,10000,20000,50000,100000
# (0.25x, 0.5x, 1x, 2x, 5x, 10x).
SIZE_MULTIPLIERS_BPS=

# When true, scripts/execute.js submits a found opportunity automatically instead
# of prompting for confirmation. Leave unset/false to require a manual "y" each time.
AUTO_CONFIRM=false

# This chain's wrapped native asset (WETH on mainnet/Arbitrum/Optimism/Base, WMATIC
# on Polygon, etc). Used to convert real gas cost into whichever pair's borrow token
# terms so net profit accounts for it. Must have a route to each pair's borrow token
# on at least one router in the winning combo.
NATIVE_WRAPPED_TOKEN=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# Safety margin added on top of the estimated gas cost, in basis points (2000 = 20%).
GAS_BUFFER_BPS=2000

# Fallback gas limit used only if on-chain gas estimation fails for a candidate trade.
DEFAULT_GAS_LIMIT=500000
