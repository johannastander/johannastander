# RPC endpoint for the network you're deploying/testing against (use a testnet first)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer/executor private key - NEVER commit the real .env file, NEVER use a mainnet key with real funds for testing
PRIVATE_KEY=0xyourprivatekey

# Optional, for contract verification
ETHERSCAN_API_KEY=

# Aave V3 PoolAddressesProvider for the target network
AAVE_ADDRESSES_PROVIDER=0x0496275d34753A48320CA58103d5220d394FF77

# The two router addresses to arbitrage between (must both implement Uniswap V2 Router interface)
ROUTER_A=
ROUTER_B=

# Token pair to arbitrage, e.g. WETH and USDC
TOKEN_BORROW=
TOKEN_INTERMEDIATE=

# Amount to borrow, in the borrow token's smallest unit
BORROW_AMOUNT=

# Deployed FlashLoanArbitrage contract address (fill in after deploy)
ARBITRAGE_CONTRACT=

# Max acceptable slippage per swap leg, in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# When true, scripts/execute.js submits a found opportunity automatically instead
# of prompting for confirmation. Leave unset/false to require a manual "y" each time.
AUTO_CONFIRM=false
